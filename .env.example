PORT=3000
# Hosts/origins allowed to reach /mcp (DNS-rebinding protection). Add your tunnel host for Alexa+.
# ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000,your-tunnel.example.com
# ALLOWED_ORIGINS=http://localhost:3000,https://your-tunnel.example.com

# Recognizer: DTW distance above which a sign is rejected ("please sign again").
RECOGNIZER_REJECT_DISTANCE=2.5
# How long a previewed action waits for YES/NO (ms).
PENDING_TTL_MS=600000

# Evidence storage: local | s3
STORAGE_MODE=local
# AWS_REGION=us-east-1
# S3_BUCKET=

# Intent parsing: rules | bedrock
INTENT_MODE=rules
# BEDROCK_MODEL_ID=   # any Bedrock model id/inference profile enabled in your account

# Confirmation safety: YES/CONFIRM must be closer than this (default 0.6 x reject distance)
# and beat the runner-up sign by this relative margin, or the user is asked to sign again.
# CONFIRM_REJECT_DISTANCE=1.5
CONFIRM_MIN_MARGIN=0.2

# Simulated Alexa+ host: scripted (offline, default) | bedrock (agentic, Bedrock Converse tool use)
SIM_AGENT=scripted
